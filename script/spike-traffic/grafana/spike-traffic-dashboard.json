{
  "uid": "cluverse-spike-traffic",
  "title": "Cluverse Spike Traffic / SLO",
  "tags": ["cluverse", "devlog-10", "spike", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLI / SLO",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Completed RPS",
      "description": "애플리케이션이 실제로 완료한 요청. k6의 offered TPS와 함께 비교한다.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "completed RPS"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Read / write p95·p99",
      "description": "GET과 쓰기 메서드를 나눠 tail latency의 붕괴 시점을 찾는다.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{method=\"GET\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "read p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by(le) (rate(http_server_requests_seconds_bucket{method=\"GET\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "read p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{method=~\"POST|PUT|PATCH|DELETE\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "write p95"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum by(le) (rate(http_server_requests_seconds_bucket{method=~\"POST|PUT|PATCH|DELETE\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "write p99"
        },
        {"refId": "E", "expr": "vector(0.8)", "legendFormat": "read p99 SLO"},
        {"refId": "F", "expr": "vector(1.5)", "legendFormat": "write p99 SLO"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "5xx"
        },
        {"refId": "B", "expr": "vector(0.001)", "legendFormat": "error SLO"}
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Application pressure",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Hikari active / pending / max",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 10},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"refId": "A", "expr": "sum(hikaricp_connections_active)", "legendFormat": "active"},
        {"refId": "B", "expr": "sum(hikaricp_connections_pending)", "legendFormat": "pending"},
        {"refId": "C", "expr": "sum(hikaricp_connections_max)", "legendFormat": "max"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connection acquire / usage",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 10},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(hikaricp_connections_acquire_seconds_count[$__rate_interval])), 0.000001)",
          "legendFormat": "acquire avg"
        },
        {
          "refId": "B",
          "expr": "sum(rate(hikaricp_connections_usage_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(hikaricp_connections_usage_seconds_count[$__rate_interval])), 0.000001)",
          "legendFormat": "usage avg"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tomcat threads / process CPU",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"refId": "A", "expr": "sum(tomcat_threads_busy_threads)", "legendFormat": "busy threads"},
        {"refId": "B", "expr": "100 * avg(process_cpu_usage{job=\"spring\"})", "legendFormat": "CPU %"}
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "MySQL / Redis",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "MySQL QPS / running threads",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"refId": "A", "expr": "rate(mysql_global_status_queries[$__rate_interval])", "legendFormat": "QPS"},
        {"refId": "B", "expr": "mysql_global_status_threads_running", "legendFormat": "running threads"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "MySQL CPU / row lock waits",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\",instance_name=\"cluverse-mysql\"}[$__rate_interval])))",
          "legendFormat": "CPU %"
        },
        {"refId": "B", "expr": "rate(mysql_global_status_innodb_row_lock_waits[$__rate_interval])", "legendFormat": "lock waits / s"}
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Redis commands / hit ratio",
      "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}},
      "targets": [
        {"refId": "A", "expr": "rate(redis_commands_processed_total[$__rate_interval])", "legendFormat": "commands / s"},
        {
          "refId": "B",
          "expr": "100 * rate(redis_keyspace_hits_total[$__rate_interval]) / clamp_min(rate(redis_keyspace_hits_total[$__rate_interval]) + rate(redis_keyspace_misses_total[$__rate_interval]), 0.000001)",
          "legendFormat": "hit %"
        }
      ]
    }
  ]
}
