{
  "title": "Cluverse Comment Pagination Before vs After",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Comment API p95 / p99",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v[12]/comments\",method=\"GET\"}[1m])))",
          "legendFormat": "{{uri}} p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v[12]/comments\",method=\"GET\"}[1m])))",
          "legendFormat": "{{uri}} p99"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hikari pending",
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    }
  ]
}
