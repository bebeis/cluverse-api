{
 "uid": "cluverse-view-surge",
 "title": "Cluverse View Surge (V4)",
 "tags": [
  "cluverse",
  "loadtest",
  "view-surge"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS_PROM",
    "label": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0,
    "refresh": 1,
    "options": [],
    "regex": ""
   }
  ]
 },
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "경로 전환 (측정 핵심)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "조회수 쓰기 경로 — Redis vs MySQL 직접",
   "description": "급상승 감지 후 V4 요청이 실제로 Redis 버퍼로 넘어갔는지 보는 그래프. MySQL 직접 경로는 V4 전체 요청에서 Redis 경로를 뺀 차분이라 스크랩 시점이 어긋나면 순간적으로 음수가 될 수 있다 — 그럴 때는 원본 두 계열로 판단한다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_count_redis_path_total[$__rate_interval]))",
     "legendFormat": "Redis 경로 (버퍼)",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v4/posts/{postId}/view-count\"}[$__rate_interval])) - sum(rate(view_count_redis_path_total[$__rate_interval]))",
     "legendFormat": "MySQL 직접 경로 (차분)",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v4/posts/{postId}/view-count\"}[$__rate_interval]))",
     "legendFormat": "V4 전체 요청",
     "refId": "C"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "V3 vs V4 조회수 증가 응답시간 p95 / p99",
   "description": "급상승이 없는 균등 트래픽에서 두 선의 간격이 곧 감지기가 요청 경로에 얹는 오버헤드다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v3/posts/{postId}/view-count\"}[$__rate_interval])))",
     "legendFormat": "V3 p95",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "histogram_quantile(0.95, sum by(le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v4/posts/{postId}/view-count\"}[$__rate_interval])))",
     "legendFormat": "V4 p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "histogram_quantile(0.99, sum by(le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v3/posts/{postId}/view-count\"}[$__rate_interval])))",
     "legendFormat": "V3 p99",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "histogram_quantile(0.99, sum by(le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v4/posts/{postId}/view-count\"}[$__rate_interval])))",
     "legendFormat": "V4 p99",
     "refId": "D"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "급상승 활성화 이벤트 (1분 증가량)",
   "description": "감지기가 view_surge_tracking에 UPSERT한 횟수. 막대가 서는 시점이 곧 경로 전환의 시작점이다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(increase(view_surge_activation_total[1m]))",
     "legendFormat": "활성화",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "라우팅 캐시 크기 (추적 중 게시글 수)",
   "description": "각 인스턴스가 Redis 경로로 라우팅 중인 게시글 수. 활성화 직후 이 값이 오르기까지가 캐시 전파 지연.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "view_surge_routing_cache_size",
     "legendFormat": "라우팅 캐시",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Redis 경로 비중",
   "description": "V4 요청 중 Redis 버퍼로 처리된 비율. 급상승 구간에서 1에 수렴해야 한다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_count_redis_path_total[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v4/posts/{postId}/view-count\"}[$__rate_interval]))",
     "legendFormat": "Redis 경로 비중",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "row",
   "title": "Write-back 플러시",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "panels": []
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "플러시 배치 크기 (avg / max)",
   "description": "한 번의 Write-back으로 MySQL에 반영한 조회수 증가량. 클수록 핫 레코드 UPDATE를 많이 접은 것.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "rate(view_surge_flush_batch_size_sum[$__rate_interval]) / rate(view_surge_flush_batch_size_count[$__rate_interval])",
     "legendFormat": "avg",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "view_surge_flush_batch_size_max",
     "legendFormat": "max",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "플러시 소요 시간 (avg / max)",
   "description": "플러시 주기보다 길어지면 워커가 밀리기 시작한다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "rate(view_surge_flush_duration_seconds_sum[$__rate_interval]) / rate(view_surge_flush_duration_seconds_count[$__rate_interval])",
     "legendFormat": "avg",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "view_surge_flush_duration_seconds_max",
     "legendFormat": "max",
     "refId": "B"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "플러시 처리량",
   "description": "플러시 실행 빈도와, 그 플러시로 MySQL에 반영된 초당 조회수. 후자가 Redis가 흡수해준 UPDATE 부하다.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_flush_duration_seconds_count[$__rate_interval]))",
     "legendFormat": "플러시 /s",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_flush_batch_size_sum[$__rate_interval]))",
     "legendFormat": "반영 조회수 /s",
     "refId": "B"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "급상승 수명주기 (활성화 / 연장 / 정리)",
   "description": "연장은 플러시 증가량이 유지 기준 이상이라 TTL을 미룬 경우, 정리는 유예 후 최종 플러시와 행 삭제까지 끝난 경우.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_activation_total[$__rate_interval]))",
     "legendFormat": "활성화 /s",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_extension_total[$__rate_interval]))",
     "legendFormat": "연장 /s",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_cleanup_total[$__rate_interval]))",
     "legendFormat": "정리 /s",
     "refId": "C"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "플러시 복구 (Redis 되돌림)",
   "description": "MySQL 반영 실패가 확실할 때 get-and-reset으로 빼온 증가량을 Redis에 되돌린 횟수. 0이 아니면 조회수 유실 위험 구간을 들여다볼 것.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROM}"
     },
     "expr": "sum(rate(view_surge_flush_restored_total[$__rate_interval]))",
     "legendFormat": "복구 /s",
     "refId": "A"
    }
   ]
  },
  {
   "id": 13,
   "type": "row",
   "title": "장애 / 폴백",
