   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 35
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 2,
      "fillOpacity": 60,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
