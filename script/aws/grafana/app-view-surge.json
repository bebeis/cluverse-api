    "w": 24,
    "x": 0,
    "y": 34
   },
   "panels": []
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Redis 폴백 발생률 (origin별)",
   "description": "Redis를 쓸 수 없어 MySQL 직접 UPDATE로 되돌아간 비율. request는 조회 요청 경로, flush는 Write-back 워커, cleanup은 만료 처리에서 발생한 폴백.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROM}"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 35
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
